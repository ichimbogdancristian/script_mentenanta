# Temporary files / local-only directories
temp_files/
archive/
docs/
scripts/

# NOTE: tests/ is deliberately NOT ignored. It holds the Pester suite that CI runs
# (.github/workflows/ci.yml) - ignoring it would leave the workflow executing tests that
# do not exist in the repo. The suite never ships to a target machine in any meaningful
# sense: script.bat extracts the whole repo zip, the orchestrator imports only modules/,
# and Stage 5 deletes the extracted tree, so the few hundred KB costs nothing.

# Self-update extraction + bootstrap download artifacts (created in the launch dir by script.bat)
script_mentenanta-master/
update.zip
pwsh.msi
*.msi
*.msix
*.msixbundle
*.tmp


# Log files
*.log

# PowerShell format/type definition files
*.ps1xml

